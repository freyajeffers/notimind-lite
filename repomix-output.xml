#!/usr/bin/env bash
set -euo pipefail

PACKAGE="${PACKAGE:-com.jeffers.notimindlite}"
SERIAL="${ANDROID_SERIAL:-}"
ADB=(adb)
[[ -n "$SERIAL" ]] && ADB+=( -s "$SERIAL" )

"${ADB[@]}" wait-for-device
"${ADB[@]}" shell pm path "$PACKAGE"
"${ADB[@]}" shell dumpsys package "$PACKAGE" | grep -E "versionName|versionCode" || true

