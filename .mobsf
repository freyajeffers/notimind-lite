---
ignore-paths:
  - build/
  - app/build/
  - app/src/test/
  - app/src/androidTest/
  - .gradle/

ignore-rules:
  # Intentional Room migrations/PRAGMA/FTS maintenance use fixed SQL constants or
  # identifier-quoted internal names; no user input reaches these statements.
  - android_kotlin_sql_raw_query
  # All production call sites route through AppLogger, which is disabled in release
  # builds. MobSF's rule cannot distinguish this centralized debug-only logger.
  - android_kotlin_logging
  # These controls are not applicable to this local-first app: it has no custom
  # TLS endpoint to pin, uses modern platform tapjacking/screenshot controls, and
  # does not make server trust decisions based on SafetyNet/root status.
  - android_certificate_pinning
  - android_certificate_transparency
  - android_ssl_pinning
  - android_root_detection
  - android_safetynet
  - android_safetynet_api
  # MobSF 1.0.1 does not recognize the manifest filterTouchesWhenObscured or
  # MainActivity FLAG_SECURE controls; both are verified in merged manifest/source.
  - android_detect_tapjacking
  - android_tapjacking
  - android_prevent_screenshot
  # App targets SDK 36 (Android 15+). StrandHogg 2.0 (targetSdk < 29) is patched at platform level.
  # AGP 9 deprecates <uses-sdk> in AndroidManifest.xml, causing mobsfscan to fallback to SDK 26.
  - android_task_hijacking2
