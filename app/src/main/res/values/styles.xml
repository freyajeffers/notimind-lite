<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Safe Mode Theme: Uses framework defaults to bypass library linking failures -->
    <style name="Theme.NotiMindLite" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorSecondary">@color/secondary</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Simple Button Style to avoid Material3.Button linking error -->
    <style name="Widget.NotiMindLite.Button" parent="@android:style/Widget.DeviceDefault.Button">
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="TextAppearance.NotiMindLite.Button" parent="@android:style/TextAppearance.DeviceDefault.Medium">
        <item name="android:textStyle">bold</item>
    </style>
</resources>